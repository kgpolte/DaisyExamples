 199:delay-module.cpp **** static void ProcessClockInput()
 200:delay-module.cpp **** {
 201:delay-module.cpp ****     // get the current state of the input
 202:delay-module.cpp ****     bool clock_read = clock.State();
 203:delay-module.cpp **** 
 204:delay-module.cpp ****     // check for rising and falling edges
 205:delay-module.cpp ****     if (clock_read && clock_read != clock_state) {
 206:delay-module.cpp ****         // set the led to full
 207:delay-module.cpp ****         led_1_b.Set(1.0f);
 208:delay-module.cpp ****         led_1_r.Set(1.0f);
 209:delay-module.cpp **** 
 210:delay-module.cpp ****         // update the stored clock state
 211:delay-module.cpp ****         clock_state = clock_read;
 212:delay-module.cpp **** 
 213:delay-module.cpp ****     } else if (!clock_read && clock_read != clock_state) {
 214:delay-module.cpp ****         // set the led to low brightness between pulses
 215:delay-module.cpp ****         led_1_b.Set(0);
 216:delay-module.cpp ****         led_1_r.Set(0);
 217:delay-module.cpp **** 
 218:delay-module.cpp ****         // update the stored clock state
 219:delay-module.cpp ****         clock_state = clock_read;
 220:delay-module.cpp ****     }
 221:delay-module.cpp **** }
