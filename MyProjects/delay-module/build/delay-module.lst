 204:../../libDaisy//src/dev/oled_ssd130x.h ****     void SendData(uint8_t* buff, size_t size)
 205:../../libDaisy//src/dev/oled_ssd130x.h ****     {
 206:../../libDaisy//src/dev/oled_ssd130x.h ****         dsy_gpio_write(&pin_dc_, 1);
