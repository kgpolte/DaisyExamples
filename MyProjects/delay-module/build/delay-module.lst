 213:delay-module.cpp **** static void ProcessClockInput()
 214:delay-module.cpp **** {
 215:delay-module.cpp ****     // get the current state of the input
 216:delay-module.cpp ****     bool clock_read = clock.State();
 217:delay-module.cpp **** 
 218:delay-module.cpp ****     // check for rising and falling edges
 219:delay-module.cpp ****     if (clock_read && clock_read != clock_state) {
 220:delay-module.cpp ****         // set the led to full
 221:delay-module.cpp ****         led_1_b.Set(1.0f);
 222:delay-module.cpp ****         led_1_r.Set(1.0f);
 223:delay-module.cpp **** 
 224:delay-module.cpp ****         // update the stored clock state
 225:delay-module.cpp ****         clock_state = clock_read;
 226:delay-module.cpp **** 
 227:delay-module.cpp ****     } else if (!clock_read && clock_read != clock_state) {
 228:delay-module.cpp ****         // set the led to low brightness between pulses
 229:delay-module.cpp ****         led_1_b.Set(0);
ARM GAS  C:\Users\kgpol\AppData\Local\Temp\ccdpmVh8.s 			page 33


 230:delay-module.cpp ****         led_1_r.Set(0);
 231:delay-module.cpp **** 
 232:delay-module.cpp ****         // update the stored clock state
 233:delay-module.cpp ****         clock_state = clock_read;
 234:delay-module.cpp ****     }
 235:delay-module.cpp **** }
