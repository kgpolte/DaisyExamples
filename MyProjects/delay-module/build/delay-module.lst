 144:delay-module.cpp **** static void UpdateDisplay()
 145:delay-module.cpp **** {
 146:delay-module.cpp ****     // Max 18 characters per line at 7x10 font size
 147:delay-module.cpp ****     // There's probably a better way to increase this
 148:delay-module.cpp ****     // and do wrapping...
 149:delay-module.cpp ****     char str_buffer[128];
 150:delay-module.cpp **** 
 151:delay-module.cpp ****     // Clear the display
 152:delay-module.cpp ****     display.Fill(false);
 153:delay-module.cpp **** 
 154:delay-module.cpp ****     // Print the first line: external clock listen
 155:delay-module.cpp ****     sprintf(str_buffer, clock_sync ? "Sync: On" : "Sync: Off");
 156:delay-module.cpp ****     display.SetCursor(0, 0);
 157:delay-module.cpp ****     display.WriteString(str_buffer, Font_7x10, true);
 158:delay-module.cpp **** 
 159:delay-module.cpp ****     // Print the second line: time range
 160:delay-module.cpp ****     switch (time_range) {
 161:delay-module.cpp ****         case 0: sprintf(str_buffer, "Range: X Fast"); break;
 162:delay-module.cpp ****         case 1: sprintf(str_buffer, "Range: Fast"); break;
 163:delay-module.cpp ****         case 2: sprintf(str_buffer, "Range: Med"); break;
 164:delay-module.cpp ****         case 3: sprintf(str_buffer, "Range: Slow"); break;
 165:delay-module.cpp ****     }
 166:delay-module.cpp ****     display.SetCursor(0, 12);
 167:delay-module.cpp ****     display.WriteString(str_buffer, Font_7x10, true);
 168:delay-module.cpp **** 
 169:delay-module.cpp ****     // Print the third line: channel link
 170:delay-module.cpp ****     sprintf(str_buffer, channel_link ? "Link: On" : "Link: Off");
 171:delay-module.cpp ****     display.SetCursor(0, 24);
 172:delay-module.cpp ****     display.WriteString(str_buffer, Font_7x10, true);
ARM GAS  C:\Users\kgpol\AppData\Local\Temp\ccIP7kIm.s 			page 32


 173:delay-module.cpp ****     display.WriteStringAligned("~KG DELAY beta v0.1~", Font_6x8, display.GetBounds(), Alignment::bo
 174:delay-module.cpp **** 
 175:delay-module.cpp ****     // Update the display
 176:delay-module.cpp ****     display.Update();
 177:delay-module.cpp **** }
